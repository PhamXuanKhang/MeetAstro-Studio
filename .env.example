# ── OpenAI (required) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Whisper Transcription ──
DEFAULT_TRANSCRIPTION_LANGUAGE=en

# ── WhisperLiveKit (self-hosted, overrides OpenAI Whisper when set) ──
# Example: wss://8000-xxxx.cloudspaces.litng.ai/asr
WHISPER_LIVEKIT_URL=

# ── Supabase database ──────────────────────────────────────────────────────────
# Base URL (KHÔNG có /rest/v1/ ở cuối — supabase-py tự thêm)
SUPABASE_URL=https://your-supabase-url.supabase.co
# Anon key (frontend dùng) — backend không cần nhưng giữ để tham khảo
SUPABASE_ANON_KEY=your-anon-key-here
# Service role key (backend dùng để ghi/đọc database)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Jira (optional - stub mode if missing) ────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-token-here
JIRA_PROJECT_KEY=MEET

# ── App Secret (required for provider_configs encryption) ─────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# ── Audio Recording ───────────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_MIC_ENABLED=true
AUDIO_MIC_GAIN=3.0
AUDIO_SYS_GAIN=0.5
AUDIO_OUTPUT_DIR=data/recordings
# Hours to retain audio files before cleanup (0 = delete immediately after success)
AUDIO_RETENTION_HOURS=24

# ── Chunked Transcription ─────────────────────────────────────────────────────
TRANSCRIPTION_CHUNK_SECONDS=60

# ── Celery + Redis (background task queue) ────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Confidence thresholds (human-in-the-loop review) ──────────────────────────
CONFIDENCE_LOW_THRESHOLD=0.4
CONFIDENCE_HIGH_THRESHOLD=0.7

# ── FastAPI backend (Electron client) ─────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# Windows Installer Download
APP_DOWNLOAD_FILENAME=MeetAstro-Setup.msi
APP_DOWNLOAD_VERSION=0.1.0
APP_DOWNLOAD_SIZE=
# Host folder mounted read-only to /app/downloads in Docker Compose
APP_DOWNLOADS_DIR=./downloads

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or "*" for all (not recommended for production)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Format: "requests/period" (e.g., "100/minute", "1000/hour")
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_TRANSCRIPTION=10/minute
RATE_LIMIT_ANALYSIS=20/minute
RATE_LIMIT_JIRA=30/minute

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── AI Hook Logging (provided by instructor) ──────────────────────────────────
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
AI_LOG_DIR=.ai-log
