# ── OpenAI (bắt buộc) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Whisper ────────────────────────────────────────────────────────────────────
WHISPER_LOCAL_MODEL=base
DEFAULT_TRANSCRIPTION_LANGUAGE=vi

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/meetings.db

# ── Jira (tùy chọn — thiếu thì chạy stub mode) ────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-token-here
JIRA_PROJECT_KEY=MEET

# ── App Secret (bắt buộc nếu dùng provider_configs encrypt — P7) ──────────────
# Sinh bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# ── Chunked Transcription (P8) ────────────────────────────────────────────────
TRANSCRIPTION_CHUNK_SECONDS=60

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── AI Hook Logging (do instructor cung cấp) ──────────────────────────────────
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
AI_LOG_DIR=.ai-log
